          "title": "Captionstate",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "outputVariantId",
        "manifest",
        "manifestHash",
        "outputHash",
        "filename",
        "captionState"
      ],
      "title": "EditPlannedOutput",
      "type": "object"
    },
