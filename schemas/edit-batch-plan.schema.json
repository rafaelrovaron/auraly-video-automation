        "profileRef": {
          "$ref": "#/$defs/ProfileRef"
        },
        "copyRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
