{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "CaptionInput": {
      "additionalProperties": false,
      "properties": {
        "copyRef": {
          "$ref": "#/$defs/CopyRef"
        },
        "voiceRef": {
          "$ref": "#/$defs/IdentityRef"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "timingStatus": {
          "enum": [
            "missing",
            "provided"
          ],
          "title": "Timingstatus",
          "type": "string"
        },
        "timingRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "manual",
                "external_alignment"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "acceptedBy": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptedby"
        },
        "timebase": {
          "anyOf": [
            {
              "const": "source_mp4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timebase"
        },
        "cues": {
          "items": {
            "$ref": "#/$defs/ResolvedCaptionCue"
          },
          "title": "Cues",
          "type": "array"
        }
      },
      "required": [
        "copyRef",
        "voiceRef",
        "text",
        "timingStatus"
      ],
      "title": "CaptionInput",
      "type": "object"
    },
    "CaptionOverride": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "styleId": {
          "minLength": 1,
          "title": "Styleid",
          "type": "string"
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fontWeight": {
          "maximum": 900,
          "minimum": 100,
          "title": "Fontweight",
          "type": "integer"
        },
        "fontSizePx": {
          "exclusiveMinimum": 0,
          "title": "Fontsizepx",
          "type": "number"
        },
        "lineHeight": {
          "exclusiveMinimum": 0,
          "title": "Lineheight",
          "type": "number"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "strokeWidthPx": {
          "minimum": 0,
          "title": "Strokewidthpx",
          "type": "number"
        },
        "strokeColor": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Strokecolor",
          "type": "string"
        },
        "shadowEnabled": {
          "title": "Shadowenabled",
          "type": "boolean"
        },
        "shadowColor": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Shadowcolor",
          "type": "string"
        },
        "shadowOffsetX": {
          "title": "Shadowoffsetx",
          "type": "number"
        },
        "shadowOffsetY": {
          "title": "Shadowoffsety",
          "type": "number"
        },
        "backgroundEnabled": {
          "title": "Backgroundenabled",
          "type": "boolean"
        },
        "backgroundColor": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Backgroundcolor",
          "type": "string"
        },
        "backgroundPaddingPx": {
          "minimum": 0,
          "title": "Backgroundpaddingpx",
          "type": "number"
        },
        "anchor": {
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "safeTop": {
          "maximum": 1,
          "minimum": 0,
          "title": "Safetop",
          "type": "number"
        },
        "safeRight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Saferight",
          "type": "number"
        },
        "safeBottom": {
          "maximum": 1,
          "minimum": 0,
          "title": "Safebottom",
          "type": "number"
        },
        "safeLeft": {
          "maximum": 1,
          "minimum": 0,
          "title": "Safeleft",
          "type": "number"
        },
        "maxLines": {
          "exclusiveMinimum": 0,
          "title": "Maxlines",
          "type": "integer"
        },
        "fitPolicy": {
          "enum": [
            "wrap",
            "shrink",
            "error"
          ],
          "title": "Fitpolicy",
          "type": "string"
        },
        "highlightEnabled": {
          "title": "Highlightenabled",
          "type": "boolean"
        },
        "highlightColor": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Highlightcolor",
          "type": "string"
        }
      },
      "title": "CaptionOverride",
      "type": "object"
    },
    "CaptionStyle": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
