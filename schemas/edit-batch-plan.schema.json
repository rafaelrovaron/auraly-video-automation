        "manifestHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifesthash",
          "type": "string"
        },
        "outputHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outputhash",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
