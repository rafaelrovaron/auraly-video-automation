          "type": "integer"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "hash"
      ],
      "title": "CopyRef",
      "type": "object"
    },
    "EditManifestV2": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "resolverVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Resolverversion",
          "type": "string"
        },
        "campaignId": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Campaignid",
          "type": "string"
        },
        "videoId": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Videoid",
          "type": "string"
        },
        "outputVariantId": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Outputvariantid",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceVideoRef"
