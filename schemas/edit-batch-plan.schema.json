        "voiceRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "musicAccepted": {
          "title": "Musicaccepted",
          "type": "boolean"
        },
        "output": {
          "$ref": "#/$defs/OutputStyle"
        },
        "headline": {
          "$ref": "#/$defs/ResolvedHeadline"
        },
        "captions": {
          "$ref": "#/$defs/CaptionStyle"
        },
        "music": {
          "$ref": "#/$defs/MusicStyle"
        },
        "framing": {
          "$ref": "#/$defs/FramingStyle"
        },
        "overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/EditOverrides"
          },
          "propertyNames": {
            "enum": [
              "campaign",
              "video",
              "outputVariant"
            ]
          },
          "title": "Overrides",
          "type": "object"
        },
        "provenance": {
          "additionalProperties": {
            "enum": [
              "profile",
              "input",
              "source",
              "campaign",
              "video",
              "outputVariant"
            ],
            "type": "string"
          },
          "title": "Provenance",
          "type": "object"
        },
        "manifestHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifesthash",
          "type": "string"
        }
      },
      "required": [
        "campaignId",
        "videoId",
        "outputVariantId",
        "source",
        "profileRef",
        "musicAccepted",
        "output",
        "headline",
        "captions",
        "music",
        "framing",
        "overrides",
        "provenance",
        "manifestHash"
      ],
