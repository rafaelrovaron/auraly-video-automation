      "title": "EditOverrides",
      "type": "object"
    },
    "EditPlannedOutput": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "outputVariantId": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Outputvariantid",
          "type": "string"
