        },
        "maxLines": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Maxlines",
          "type": "integer"
        },
        "fitPolicy": {
          "default": "wrap",
          "enum": [
            "wrap",
            "shrink",
            "error"
          ],
          "title": "Fitpolicy",
          "type": "string"
        },
        "startSec": {
          "default": 0,
          "minimum": 0,
          "title": "Startsec",
          "type": "number"
        },
        "endSec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endsec"
        }
      },
      "title": "HeadlineStyle",
      "type": "object"
    },
    "MusicStyle": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "volumeDb": {
          "default": -22,
          "title": "Volumedb",
          "type": "number"
        },
        "duckUnderVoiceDb": {
          "default": -8,
          "title": "Duckundervoicedb",
          "type": "number"
        },
        "loop": {
          "default": true,
          "title": "Loop",
          "type": "boolean"
        },
        "trimStartSec": {
          "default": 0,
          "minimum": 0,
          "title": "Trimstartsec",
          "type": "number"
        },
        "trimEndSec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trimendsec"
        },
        "fadeInSec": {
          "default": 0.4,
          "minimum": 0,
          "title": "Fadeinsec",
          "type": "number"
        },
        "fadeOutSec": {
          "default": 1,
          "minimum": 0,
          "title": "Fadeoutsec",
          "type": "number"
        }
      },
      "title": "MusicStyle",
      "type": "object"
    },
    "OutputStyle": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "default": 1080,
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1920,
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "format": {
          "const": "mp4",
          "default": "mp4",
          "title": "Format",
          "type": "string"
        },
        "codec": {
          "const": "h264",
          "default": "h264",
          "title": "Codec",
          "type": "string"
        }
      },
      "title": "OutputStyle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "profileId": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Profileid",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "defaults": {
      "$ref": "#/$defs/EditDefaults"
    }
  },
  "required": [
    "profileId",
    "name",
    "version",
    "createdAt",
    "defaults"
  ],
  "title": "EditProfile",
  "type": "object",
  "$id": "https://auraly.local/schemas/edit-profile.schema.json"
}
