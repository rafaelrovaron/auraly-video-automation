        },
        "color": {
          "default": "#FFFFFF",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "strokeWidthPx": {
          "default": 0,
          "minimum": 0,
          "title": "Strokewidthpx",
          "type": "number"
        },
        "strokeColor": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Strokecolor",
          "type": "string"
        },
        "shadowEnabled": {
          "default": false,
          "title": "Shadowenabled",
          "type": "boolean"
        },
        "shadowColor": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Shadowcolor",
          "type": "string"
        },
        "shadowOffsetX": {
          "default": 0,
          "title": "Shadowoffsetx",
          "type": "number"
        },
        "shadowOffsetY": {
          "default": 0,
          "title": "Shadowoffsety",
          "type": "number"
        },
        "backgroundEnabled": {
          "default": false,
          "title": "Backgroundenabled",
          "type": "boolean"
        },
        "backgroundColor": {
          "default": "#000000",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Backgroundcolor",
          "type": "string"
        },
        "backgroundPaddingPx": {
          "default": 0,
          "minimum": 0,
          "title": "Backgroundpaddingpx",
          "type": "number"
        },
        "anchor": {
          "default": "top",
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.1,
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "safeTop": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Safetop",
          "type": "number"
        },
        "safeRight": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Saferight",
          "type": "number"
        },
        "safeBottom": {
          "default": 0.05,
          "maximum": 1,
