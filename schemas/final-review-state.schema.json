        "masterSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mastersha256",
          "type": "string"
        },
        "sizeBytes": {
          "exclusiveMinimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "receiptSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receiptsha256",
          "type": "string"
        },
        "qcReportSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qcreportsha256",
