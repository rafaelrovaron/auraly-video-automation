        "campaignId",
        "videoId",
        "planHash",
        "outputVariantId",
        "renderKey",
        "qcKey",
        "decision",
        "reviewedBy",
        "watchedAndListened",
        "reviewedAt",
        "reviewKey",
        "masterPath",
        "masterSha256",
        "sizeBytes",
        "receiptSha256",
        "qcReportSha256",
        "qcStatus"
