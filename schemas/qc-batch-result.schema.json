{
  "$defs": {
    "QcFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "field",
        "message"
      ],
      "title": "QcFinding",
      "type": "object"
    },
    "QcOutputResult": {
      "additionalProperties": false,
      "properties": {
        "outputVariantId": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Outputvariantid",
          "type": "string"
        },
        "renderKey": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Renderkey",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "blocked",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "reused": {
          "default": false,
          "title": "Reused",
          "type": "boolean"
        },
        "qcKey": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qckey"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/QcFinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "outputVariantId",
        "renderKey",
        "status"
      ],
      "title": "QcOutputResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "campaignId": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Campaignid",
      "type": "string"
    },
    "videoId": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Videoid",
      "type": "string"
    },
    "planHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Planhash",
      "type": "string"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/QcOutputResult"
      },
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    },
    "hasFailures": {
      "readOnly": true,
      "title": "Hasfailures",
      "type": "boolean"
    }
  },
  "required": [
    "campaignId",
    "videoId",
    "planHash",
    "outputs",
    "hasFailures"
  ],
  "title": "QcBatchResult",
  "type": "object",
  "$id": "https://auraly.local/schemas/qc-batch-result.schema.json"
}
