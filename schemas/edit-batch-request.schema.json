          "minimum": 0,
          "title": "Backgroundpaddingpx",
          "type": "number"
        },
        "anchor": {
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "safeTop": {
          "maximum": 1,
          "minimum": 0,
          "title": "Safetop",
          "type": "number"
        },
        "safeRight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Saferight",
          "type": "number"
        },
        "safeBottom": {
          "maximum": 1,
          "minimum": 0,
