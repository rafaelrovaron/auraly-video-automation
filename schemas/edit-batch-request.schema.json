        "fitPolicy": {
          "enum": [
            "wrap",
            "shrink",
            "error"
          ],
          "title": "Fitpolicy",
          "type": "string"
        },
        "highlightEnabled": {
          "title": "Highlightenabled",
          "type": "boolean"
        },
        "highlightColor": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Highlightcolor",
          "type": "string"
        }
