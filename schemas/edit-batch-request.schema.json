    "campaignId": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Campaignid",
      "type": "string"
    },
    "renderId": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Renderid",
      "type": "string"
    },
    "videoId": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Videoid",
      "type": "string"
