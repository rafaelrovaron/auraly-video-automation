        "fontWeight": {
          "maximum": 900,
          "minimum": 100,
          "title": "Fontweight",
          "type": "integer"
        },
        "fontSizePx": {
          "exclusiveMinimum": 0,
          "title": "Fontsizepx",
          "type": "number"
        },
        "lineHeight": {
          "exclusiveMinimum": 0,
          "title": "Lineheight",
          "type": "number"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "strokeWidthPx": {
          "minimum": 0,
          "title": "Strokewidthpx",
          "type": "number"
        },
        "strokeColor": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Strokecolor",
          "type": "string"
        },
        "shadowEnabled": {
          "title": "Shadowenabled",
          "type": "boolean"
        },
        "shadowColor": {
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Shadowcolor",
          "type": "string"
        },
        "shadowOffsetX": {
          "title": "Shadowoffsetx",
          "type": "number"
        },
        "shadowOffsetY": {
          "title": "Shadowoffsety",
          "type": "number"
