          "type": "number"
        },
        "safeLeft": {
          "maximum": 1,
          "minimum": 0,
          "title": "Safeleft",
          "type": "number"
        },
        "maxLines": {
          "exclusiveMinimum": 0,
          "title": "Maxlines",
          "type": "integer"
