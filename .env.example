# Optional local root. Defaults to ~/Documents/Auraly.
AURALY_PROJECT_ROOT=

# Optional Campaign metadata SQLite file. Defaults to ~/.auraly/auraly.db outside Git.
# Store metadata/state only; never put credentials, cookies, signed URLs, or media in SQLite.
AURALY_DATABASE_PATH=

# Trusted Google Flow browser download root. Defaults to ~/Downloads.
# Every mechanical image-generation phase validates its context against this value.
# The dedicated persistent Chromium profile is runtime-planned and must stay outside Git.
AURALY_DOWNLOADS_DIR=

# Optional stock media providers. Never commit real values.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Disable HyperFrames telemetry for local production.
HYPERFRAMES_NO_TELEMETRY=1
